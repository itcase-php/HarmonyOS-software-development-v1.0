# Pinned source archives. Override FETCHCONTENT_SOURCE_DIR_HDM_* for an offline build.
include(FetchContent)
if(POLICY CMP0135)
    cmake_policy(SET CMP0135 NEW)
endif()
set(hdm_archive_root "${CMAKE_CURRENT_LIST_DIR}/../../../../../third_party/archives")
function(hdm_archive name upstream output)
    if(EXISTS "${hdm_archive_root}/${name}")
        set(${output} "${hdm_archive_root}/${name}" PARENT_SCOPE)
    else()
        set(${output} "${upstream}" PARENT_SCOPE)
    endif()
endfunction()
hdm_archive(zlib-1.3.2.tar.gz https://zlib.net/zlib-1.3.2.tar.gz hdm_zlib_url)
hdm_archive(libpng-1.6.59.tar.gz https://codeload.github.com/pnggroup/libpng/tar.gz/refs/tags/v1.6.59 hdm_png_url)
hdm_archive(miniz-3.1.2.tar.gz https://codeload.github.com/richgel999/miniz/tar.gz/refs/tags/3.1.2 hdm_miniz_url)
hdm_archive(tinyxml2-11.0.0.tar.gz https://codeload.github.com/leethomason/tinyxml2/tar.gz/refs/tags/11.0.0 hdm_xml_url)
FetchContent_Declare(hdm_zlib URL "${hdm_zlib_url}"
    URL_HASH SHA256=bb329a0a2cd0274d05519d61c667c062e06990d72e125ee2dfa8de64f0119d16 SOURCE_SUBDIR hdm_population_only)
FetchContent_Declare(hdm_png URL "${hdm_png_url}"
    URL_HASH SHA256=2540302a1844ad2b2b501977abecfa850f265f97b78f065a712ab4074a89f5b5 SOURCE_SUBDIR hdm_population_only)
FetchContent_Declare(hdm_miniz URL "${hdm_miniz_url}"
    URL_HASH SHA256=98468f8924934b723276680f85238b6c78bf1f8b49b4459cc9b7214a20e2e9fb SOURCE_SUBDIR hdm_population_only)
FetchContent_Declare(hdm_xml URL "${hdm_xml_url}"
    URL_HASH SHA256=5556deb5081fb246ee92afae73efd943c889cef0cafea92b0b82422d6a18f289 SOURCE_SUBDIR hdm_population_only)
FetchContent_MakeAvailable(hdm_zlib hdm_png hdm_miniz hdm_xml)
set(zlib_sources adler32.c compress.c crc32.c deflate.c infback.c inffast.c inflate.c inftrees.c trees.c uncompr.c zutil.c)
list(TRANSFORM zlib_sources PREPEND "${hdm_zlib_SOURCE_DIR}/")
add_library(hdm_core_zlib STATIC ${zlib_sources})
target_include_directories(hdm_core_zlib PUBLIC "${hdm_zlib_SOURCE_DIR}")
# Keep compression symbols distinct from the bundled Office dependencies.
target_compile_definitions(hdm_core_zlib PUBLIC Z_PREFIX)
set(png_sources png.c pngerror.c pngget.c pngmem.c pngpread.c pngread.c pngrio.c pngrtran.c pngrutil.c pngset.c pngtrans.c pngwio.c pngwrite.c pngwtran.c pngwutil.c)
list(TRANSFORM png_sources PREPEND "${hdm_png_SOURCE_DIR}/")
configure_file("${hdm_png_SOURCE_DIR}/scripts/pnglibconf.h.prebuilt" "${CMAKE_CURRENT_BINARY_DIR}/hdm-deps/pnglibconf.h" COPYONLY)
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/hdm-deps/miniz_export.h" "#pragma once\n#define MINIZ_EXPORT\n")
add_library(hdm_core_png STATIC ${png_sources})
target_include_directories(hdm_core_png PUBLIC "${hdm_png_SOURCE_DIR}" "${CMAKE_CURRENT_BINARY_DIR}/hdm-deps")
target_compile_definitions(hdm_core_png PUBLIC PNG_STATIC PRIVATE PNG_ARM_NEON_OPT=0)
target_link_libraries(hdm_core_png PUBLIC hdm_core_zlib)
add_library(hdm_core_miniz STATIC "${hdm_miniz_SOURCE_DIR}/miniz.c" "${hdm_miniz_SOURCE_DIR}/miniz_zip.c"
    "${hdm_miniz_SOURCE_DIR}/miniz_tdef.c" "${hdm_miniz_SOURCE_DIR}/miniz_tinfl.c")
target_include_directories(hdm_core_miniz PUBLIC "${hdm_miniz_SOURCE_DIR}" "${CMAKE_CURRENT_BINARY_DIR}/hdm-deps")
target_compile_definitions(hdm_core_miniz PUBLIC MINIZ_NO_ZLIB_COMPATIBLE_NAMES)
add_library(hdm_core_xml STATIC "${hdm_xml_SOURCE_DIR}/tinyxml2.cpp")
target_include_directories(hdm_core_xml PUBLIC "${hdm_xml_SOURCE_DIR}")
foreach(dependency hdm_core_zlib hdm_core_png hdm_core_miniz hdm_core_xml)
    set_target_properties(${dependency} PROPERTIES POSITION_INDEPENDENT_CODE ON C_VISIBILITY_PRESET hidden CXX_VISIBILITY_PRESET hidden)
endforeach()
add_library(hdm_document_inputs STATIC "${CMAKE_CURRENT_LIST_DIR}/png_pdf.cpp" "${CMAKE_CURRENT_LIST_DIR}/office_input.cpp"
    "${CMAKE_CURRENT_LIST_DIR}/office_media.cpp")
get_target_property(hdm_jpeg_includes hdm_jpeg_pdf INCLUDE_DIRECTORIES)
target_include_directories(hdm_document_inputs PRIVATE ${hdm_jpeg_includes})
target_compile_features(hdm_document_inputs PUBLIC cxx_std_17)
target_link_libraries(hdm_document_inputs PUBLIC hdm_core_png hdm_core_miniz hdm_core_xml hdm_jpeg_pdf)
set_target_properties(hdm_document_inputs PROPERTIES POSITION_INDEPENDENT_CODE ON CXX_VISIBILITY_PRESET hidden)
