index 000000000..8bc4fca83
--- /dev/null
+++ b/external/fontconfig/ohos-regenerate.sh
@@ -0,0 +1,6 @@
+#!/bin/sh
+# Preserve the SONAME adjustment from fontconfig-2.12.1.patch.1 after autoreconf.
+set -eu
+autoreconf -f -i
+grep -Fq '$wl-soname $wl$soname' configure
+sed -i 's/\$wl-soname \$wl\$soname//g' configure
